1786405071 container exec_create: python3 -c 
import glob, json, sys
want = sys.argv[1].lower()
for f in sorted(glob.glob('/var/lib/globular/services/*.json')):
    try:
        d = json.load(open(f))
    except Exception:
        continue
    name = str(d.get('Name') or '').lower()
    # Only Name-bearing configs are authoritative; ignore the legacy seeds.
    if not name:
        continue
    if name == want or name.split('.')[0] == want:
        port = d.get('Port')
        if port:
            print(port)
            break
