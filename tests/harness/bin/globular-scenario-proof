#!/usr/bin/env python3
"""Proof-boundary wrapper around the scenario executor."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def main() -> None:
    args = sys.argv[1:]
    verbose_args = [a for a in args if a in ("--verbose", "-v")]
    positional = [a for a in args if a not in ("--verbose", "-v")]
    if len(positional) < 2:
        print(
            "Usage: globular-scenario-proof <scenario.yaml> <output-dir> [--verbose]",
            file=sys.stderr,
        )
        sys.exit(1)

    scenario = Path(positional[0])
    output_dir = Path(positional[1])
    script_dir = Path(__file__).resolve().parent
    harness_dir = script_dir.parent
    contract = harness_dir / "lib" / "scenario_contract_semantic.py"
    change_binding = harness_dir / "lib" / "change_binding.py"
    executor = script_dir / "globular-scenario-semantic"

    output_dir.mkdir(parents=True, exist_ok=True)

    pre = subprocess.run(
        [sys.executable, str(contract), "preflight", str(scenario), str(output_dir)]
    )
    if pre.returncode != 0:
        # UNSUPPORTED/invalid proof is intentionally a failing certification result.
        # Still attach a change binding when one was supplied so the failed proof
        # remains attributable to the governed change that requested it.
        subprocess.run(
            [sys.executable, str(change_binding), str(output_dir)], check=False
        )
        sys.exit(1)

    bound_pre = subprocess.run(
        [sys.executable, str(change_binding), str(output_dir)], check=False
    )
    if bound_pre.returncode != 0:
        # A partial or required-but-absent change binding is a proof error. Do not
        # mutate the cluster when we cannot prove which candidate is under test.
        sys.exit(1)

    run = subprocess.run(
        [sys.executable, str(executor), str(scenario), str(output_dir), *verbose_args]
    )

    # Finalization must never hide the executor's result.
    subprocess.run(
        [
            sys.executable,
            str(contract),
            "finalize",
            str(scenario),
            str(output_dir),
            "--executor-exit",
            str(run.returncode),
        ],
        check=False,
    )
    bound_final = subprocess.run(
        [sys.executable, str(change_binding), str(output_dir)], check=False
    )
    if run.returncode == 0 and bound_final.returncode != 0:
        # A green executor result cannot erase a broken proof identity.
        sys.exit(1)
    sys.exit(run.returncode)


if __name__ == "__main__":
    main()
