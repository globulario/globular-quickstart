import glob,json
for f in glob.glob('/var/lib/globular/services/*.json'):
    try: d=json.load(open(f))
    except Exception: continue
    if str(d.get('Name','')).lower().startswith('workflow'):
        print(f.split('/')[-1], d.get('Name'), 'Port=',d.get('Port'), 'Proxy=',d.get('Proxy'))
