#!/usr/bin/env python3
"""
globular-scenario — YAML scenario executor for Globular V1 test harness.

Usage: globular-scenario <scenario.yaml> <output-dir> [--verbose]

Parses a scenario YAML file and executes its sections in order:
  preconditions → baseline → steps → assertions → cleanup

Each probe/action maps to a bash function in tests/harness/lib/probes.sh.
Results are collected as JSON evidence and a markdown summary is written
to <output-dir>/evidence.json and <output-dir>/RESULT.md.

Exit code: 0 = PASS, 1 = FAIL
"""

import sys
import os
import json
import subprocess
import datetime
import time
import shlex
import warnings

warnings.filterwarnings("ignore", category=DeprecationWarning)

try:
    import yaml
except ImportError:
    print("ERROR: pyyaml required. Run: pip3 install pyyaml", file=sys.stderr)
    sys.exit(1)

HARNESS_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LIB_DIR = os.path.join(HARNESS_DIR, "lib")
PROBES_SH = os.path.join(LIB_DIR, "probes.sh")
AWARENESS_SH = os.path.join(LIB_DIR, "awareness.sh")
EVIDENCE_SH = os.path.join(LIB_DIR, "evidence.sh")
TRAINING_SH = os.path.join(LIB_DIR, "training.sh")
LEDGER_FILE = os.path.join(
    os.path.dirname(HARNESS_DIR), "reports", "awareness-training-ledger.jsonl"
)


class AwarenessCollector:
    """
    Calls awareness.sh functions to collect evidence before/after a scenario.
    All calls are non-fatal — awareness failures never hide scenario failures.
    """

    def __init__(self, cfg: dict, output_dir: str):
        self.cfg = cfg or {}
        self.output_dir = output_dir
        self.enabled = bool(self.cfg.get("enabled", False))
        self.task = self.cfg.get("task", "")
        self.phase = self.cfg.get("phase", "")
        self.include_runtime = bool(self.cfg.get("include_runtime",
            os.environ.get("AWARENESS_INCLUDE_RUNTIME", "0") == "1"))
        self.runtime_window = self.cfg.get("runtime_window",
            os.environ.get("AWARENESS_RUNTIME_WINDOW", "30m"))
        self.create_incident = bool(self.cfg.get("create_incident_on_failure", False))
        self.create_proposal = bool(self.cfg.get("create_proposal_on_failure", False))
        self.expected_failure_modes = self.cfg.get("expected_failure_modes", [])
        training = self.cfg.get("training", {}) or {}
        self.training_enabled = bool(training.get("enabled",
            os.environ.get("AWARENESS_TRAINING", "0") == "1"))
        self._had_error = False
        self.patterns_cfg = self.cfg.get("patterns") or {}
        self.patterns_validate = self.patterns_cfg.get("validate") or []
        self.expected_invariants_for_patterns = self.patterns_cfg.get("expected_invariants") or []
        self.expected_code_smells_absent = self.patterns_cfg.get("expected_code_smells_absent") or []
        self._pattern_result = "SKIPPED"

    def _run(self, func: str, *args) -> bool:
        """Source awareness.sh and call func with args via bash. Returns True on success."""
        if not os.path.exists(AWARENESS_SH):
            return False
        quoted = " ".join(shlex.quote(str(a)) for a in args)
        cmd = f'source "{AWARENESS_SH}" && {func} {quoted}'
        try:
            proc = subprocess.run(["bash", "-c", cmd], timeout=180)
            return proc.returncode == 0
        except subprocess.TimeoutExpired:
            print(f"  [awareness] WARNING: {func} timed out after 180s")
            self._had_error = True
            return False
        except Exception as e:
            print(f"  [awareness] WARNING: {func} error: {e}")
            self._had_error = True
            return False

    def preflight(self) -> None:
        if self.task:
            ok = self._run("awareness_preflight", self.task, self.phase, self.output_dir,
                           "1" if self.include_runtime else "0", self.runtime_window)
            if not ok:
                skipped = os.path.join(self.output_dir, "awareness", "SKIPPED.txt")
                if not os.path.exists(skipped):
                    self._had_error = True

    def runtime_snapshot(self) -> None:
        if self.enabled and self.include_runtime:
            self._run("awareness_runtime_snapshot", self.output_dir)

    def on_failure(self) -> None:
        if not self.task:
            return
        self._run("awareness_debug_session", self.task, self.phase, self.output_dir)
        self._run("awareness_did_we_fix", self.task, self.output_dir)
        want_incident = self.create_incident or self.training_enabled
        if want_incident:
            self._run("awareness_incident_from_failure", self.task, self.output_dir)
            if self.create_proposal:
                self._run("awareness_propose_from_incident", self.output_dir)

    def collect_patterns(self) -> str:
        """Collect pattern evidence. Returns 'PASS', 'WARN', 'SKIPPED', or 'FAIL'."""
        if not self.patterns_validate:
            return "SKIPPED"
        patterns_csv = ",".join(self.patterns_validate)
        preflight_json = os.path.join(self.output_dir, "awareness", "preflight.json")
        preflight_arg = preflight_json if os.path.exists(preflight_json) else ""
        self._run("awareness_collect_patterns", patterns_csv, self.output_dir, preflight_arg)
        val_file = os.path.join(self.output_dir, "awareness", "patterns", "validation.json")
        if not os.path.exists(val_file):
            return "SKIPPED"
        try:
            with open(val_file) as f:
                val = json.load(f)
            return val.get("overall_result", "SKIPPED")
        except Exception:
            return "WARN"

    def get_result(self) -> str:
        """Return AWARENESS_PASS, AWARENESS_SKIPPED, or AWARENESS_ERROR."""
        adir = os.path.join(self.output_dir, "awareness")
        if not os.path.isdir(adir):
            return "AWARENESS_SKIPPED"
        if os.path.exists(os.path.join(adir, "SKIPPED.txt")):
            return "AWARENESS_SKIPPED"
        if self._had_error:
            return "AWARENESS_ERROR"
        for artifact in ["preflight.agent.txt", "preflight.json",
                         "debug-session.agent.txt", "debug-session.json"]:
            if os.path.exists(os.path.join(adir, artifact)):
                return "AWARENESS_PASS"
        return "AWARENESS_SKIPPED"


class EvidenceCollector:
    """Calls evidence.sh to collect full cluster state after scenario failure."""

    def __init__(self, output_dir: str):
        self.output_dir = output_dir

    def collect(self, scenario_file: str = "", result_json_path: str = "") -> None:
        if not os.path.exists(EVIDENCE_SH):
            return
        args = [shlex.quote(self.output_dir)]
        if scenario_file:
            args.append(shlex.quote(scenario_file))
        if result_json_path:
            args.append(shlex.quote(result_json_path))
        cmd = f'source "{EVIDENCE_SH}" && evidence_collect_all {" ".join(args)}'
        try:
            subprocess.run(["bash", "-c", cmd], timeout=180)
        except subprocess.TimeoutExpired:
            print("  [evidence] WARNING: collection timed out after 180s")
        except Exception as e:
            print(f"  [evidence] WARNING: collection error: {e}")


class Evidence:
    def __init__(self, scenario_name: str, suite: str):
        self.scenario_name = scenario_name
        self.suite = suite
        self.start_time = datetime.datetime.utcnow()
        self.items: list = []
        self.passed = True

    def record(self, section: str, item_id: str, probe: str, params: dict,
               expect: dict, result: dict, passed: bool):
        self.items.append({
            "id": item_id,
            "section": section,
            "probe": probe,
            "params": params,
            "expect": expect,
            "result": result,
            "passed": passed,
            "timestamp": datetime.datetime.utcnow().isoformat() + "Z",
        })
        if not passed:
            self.passed = False

    def to_dict(self) -> dict:
        return {
            "schema_version": 1,
            "scenario": self.scenario_name,
            "suite": self.suite,
            "start_time": self.start_time.isoformat() + "Z",
            "end_time": datetime.datetime.utcnow().isoformat() + "Z",
            "passed": self.passed,
            "item_count": len(self.items),
            "items": self.items,
        }


class ScenarioExecutor:
    def __init__(self, scenario_file: str, output_dir: str, verbose: bool = False):
        self.scenario_file = scenario_file
        self.output_dir = output_dir
        self.verbose = verbose

        with open(scenario_file) as f:
            self.scenario = yaml.safe_load(f)

        name = self.scenario.get("name", os.path.basename(scenario_file))
        suite = self.scenario.get("suite", "unknown")
        self.evidence = Evidence(name, suite)
        self.baseline_captures: dict = {}
        # Mutation ledger. A destructive scenario is incomplete until every
        # mutated observable property is proven back at its captured state, so
        # the runner tracks mutations itself rather than trusting each YAML to
        # remember its own inverse. Entries are added when a destructive action
        # succeeds and removed when its inverse succeeds; whatever is still here
        # at teardown is residue and is reversed + verified by
        # _enforce_restoration(). This exists because a scenario that fails or
        # times out mid-way never reaches the `start_node` sitting in its steps.
        self.outstanding: list[dict] = []
        self.restoration_report: dict = {}
        self.awareness = AwarenessCollector(
            self.scenario.get("awareness", {}), output_dir)
        self.evidence_collector = EvidenceCollector(output_dir)

    # ── public entry point ────────────────────────────────────────────────────

    def run(self) -> bool:
        name = self.scenario.get("name", "?")
        desc = self.scenario.get("description", "")
        print(f"  Scenario: {name}")
        if desc:
            print(f"  {desc}")

        if not self._validate_schema():
            return False

        # Check cluster reachability for INFRA_ERROR classification.
        cluster_ok = self._cluster_reachable()
        if not cluster_ok:
            print("  [WARNING] Cluster nodes not reachable — running in degraded mode")

        # Capture the structural baseline BEFORE anything runs. This is the
        # state the postcondition gate will require the cluster to return to.
        # Captured even for non-destructive scenarios: a scenario that claims to
        # mutate nothing still has to leave the cluster where it found it.
        if cluster_ok:
            self.baseline_captures["_health_fingerprint"] = self._health_fingerprint()

        # Awareness preflight — before any scenario sections run.
        self.awareness.preflight()
        # Collect pattern evidence immediately after preflight (while graph is warm).
        self.awareness._pattern_result = self.awareness.collect_patterns()

        # Execute sections in order. Stop early on precondition or assertion failure,
        # but ALWAYS run cleanup regardless of earlier failures so chaos tests can
        # restore cluster state even when assertions expose a catastrophic failure.
        sections = [
            ("preconditions", self._exec_probes, True),   # stop on fail
            ("baseline",      self._exec_probes, False),  # capture only
            ("steps",         self._exec_steps,  False),  # actions
            ("assertions",    self._exec_probes, True),   # stop on fail (cleanup still runs)
            ("cleanup",       self._exec_steps,  False),  # always runs — best-effort restore
        ]

        overall_ok = True
        stopped_at = None
        steps_ok = True
        crashed = None
        # The section loop is wrapped because restoration must be reachable from
        # EVERY path, not just the anticipated ones. _exec_chaos catches its own
        # exceptions, but _exec_steps/_exec_probes/_exec_wait/_call_probe do not:
        # a malformed probe response or a type error in _check_expect raised
        # AFTER a mutation had landed would propagate out of run() and skip
        # teardown entirely — losing restoration at exactly the moment the
        # scenario went most wrong. An unconditional law with an unguarded loop
        # is only unconditional on the happy path.
        try:
            for section, handler, stop_on_fail in sections:
                items = self.scenario.get(section, [])
                if not items:
                    continue
                # Skip intermediate sections if stopped, but ALWAYS run cleanup
                if stopped_at and section != "cleanup":
                    print(f"  [SKIP] {section} (stopped at {stopped_at})")
                    continue
                print(f"  [{section}]")
                ok = handler(items, section)
                if section == "steps" and not ok:
                    steps_ok = False
                if not ok:
                    overall_ok = False
                    if stop_on_fail and stopped_at is None:
                        stopped_at = section
                        print(f"  STOPPED: {section} failed — cleanup will still run")

            # Enforce restoration AFTER cleanup, unconditionally. The YAML `cleanup`
            # section is best-effort and only covers what its author remembered; this
            # covers what the scenario actually did, including when it stopped early
            # and never reached its own restore step. Residue fails the scenario:
            # a successful mutation followed by an unverified cleanup is still a
            # failed scenario, and residue is how one test becomes the next test's
            # ghost.

        except Exception as exc:
            crashed = f"{type(exc).__name__}: {exc}"
            overall_ok = False
            steps_ok = False
            print(f"  CRASH: scenario raised {crashed} — teardown still runs")
            self.evidence.record("steps", "scenario_crash", "exception", {}, {},
                                 {"error": crashed[:500]}, False)

        # `cluster.reset_after: true` means this scenario does damage it cannot
        # itself undo, and the cluster must be rebuilt before anything else
        # runs. Do it BEFORE residue/postcondition checks so those judge the
        # rebuilt cluster rather than the wreckage.
        #
        # This field was declared by scenarios and implemented NOWHERE — the
        # whole harness had no reference to it. etcd-detach-before-wipe removes
        # two of three etcd members and set reset_after: true precisely so it
        # "cannot leave a 1-member cluster behind for whatever runs next"; with
        # the flag inert it did exactly that, and etcd-member-resync then failed
        # its precondition with healthy=1/3 for reasons that had nothing to do
        # with what it tests. A declared safety mechanism that does not exist is
        # worse than no mechanism, because scenarios are written trusting it.
        if self._cluster_cfg().get("reset_after"):
            self._reset_cluster()

        residue_failure = False
        if not self._enforce_restoration():
            overall_ok = False
            steps_ok = False
            residue_failure = True
            print("  RESIDUE: scenario left unrestored mutations — marking FAILED")

        # Post-scenario health gate. The ledger only knows about mutations the
        # harness made; this proves the world as a whole came back, including
        # side effects nobody declared. Automatic healing inside the window is
        # allowed — silently ending in a structurally different cluster is not.
        postcondition_failure = False
        if not self._verify_postconditions():
            overall_ok = False
            postcondition_failure = True

        # Determine result classification. RESIDUE and POSTCONDITION are named
        # distinctly so a report never conflates "this scenario leaked" with
        # "this scenario's assertions were wrong".
        if not cluster_ok and not overall_ok and stopped_at == "preconditions":
            result = "INFRA_ERROR"
        elif residue_failure:
            result = "RESIDUE"
        elif postcondition_failure:
            result = "POSTCONDITION"
        elif not overall_ok and steps_ok and stopped_at == "assertions":
            result = "FAIL"
        elif not overall_ok and not steps_ok:
            result = "PARTIAL"
        else:
            result = "PASS" if overall_ok else "FAIL"

        # Awareness post-scenario collection.
        self.awareness.runtime_snapshot()
        if not overall_ok:
            self.awareness.on_failure()
            result_json_path = os.path.join(self.output_dir, "evidence.json")
            self.evidence_collector.collect(self.scenario_file, result_json_path)

        awareness_result = self.awareness.get_result()
        self._write_output(overall_ok, result, awareness_result)
        self._append_to_ledger(result, awareness_result)
        return overall_ok

    def _cluster_cfg(self) -> dict:
        """The scenario's `cluster:` block, or an empty dict."""
        cfg = self.scenario.get("cluster") if isinstance(self.scenario, dict) else None
        return cfg if isinstance(cfg, dict) else {}

    def _reset_cluster(self, ready_timeout: int = 3600) -> bool:
        """Tear the cluster down and bring it back, then wait for all nodes ready.

        Used by `cluster.reset_after`. Expensive (a full Day-0 + Day-1 bring-up),
        so it only runs for scenarios that explicitly ask for it.
        """
        # HARNESS_DIR is <repo>/tests/harness, so the compose file lives two
        # levels up. Derive it rather than relying on the caller's cwd.
        compose_dir = os.path.dirname(os.path.dirname(HARNESS_DIR))
        print("    RESET: rebuilding cluster (scenario declared reset_after)")
        self._sh(["docker", "compose", "down", "-v"], timeout=300, cwd=compose_dir)
        up = self._sh(["docker", "compose", "up", "-d"], timeout=600, cwd=compose_dir)
        if up.returncode != 0:
            print(f"    RESET FAILED: compose up returned {up.returncode}")
            return False

        deadline = time.time() + ready_timeout
        while time.time() < deadline:
            proc = self._sh(["docker", "exec", "globular-node-1",
                             "globular", "cluster", "nodes", "list",
                             "--controller", "10.10.0.11:12000",
                             "--insecure", "--timeout", "30s"], timeout=90)
            ready = proc.stdout.count('status: "ready"')
            if ready >= 5:
                print(f"    RESET: cluster ready ({ready}/5)")
                # `compose down -v` destroyed the MinIO drive volumes, so the
                # rebuilt cluster is back in standalone mode. Restore the
                # intended distributed topology, or every scenario after a
                # reset_after runs against a different objectstore than the
                # one the suite started on — and the post-run doctor reports
                # objectstore.standalone_in_cluster for a state the harness
                # itself created.
                prov = os.path.join(compose_dir, "scripts",
                                    "provision-distributed-objectstore.sh")
                if os.path.exists(prov):
                    print("    RESET: restoring distributed objectstore")
                    r = self._sh(["bash", prov], timeout=2400, cwd=compose_dir)
                    if r.returncode != 0:
                        print(f"    RESET: objectstore provisioning failed "
                              f"(rc={r.returncode}) — scenarios continue against standalone")
                # The mutations this scenario made are gone with the old
                # cluster; keeping them outstanding would report residue that
                # no longer exists anywhere.
                self.outstanding = []
                return True
            time.sleep(60)
        print("    RESET: timed out waiting for cluster ready")
        return False

    def _cluster_reachable(self) -> bool:
        """Quick check if globular-node-1 container is running."""
        try:
            proc = subprocess.run(
                ["docker", "inspect", "globular-node-1",
                 "--format", "{{.State.Running}}"],
                capture_output=True, text=True, timeout=10)
            return proc.returncode == 0 and proc.stdout.strip() == "true"
        except Exception:
            return False

    # ── section handlers ──────────────────────────────────────────────────────

    def _exec_probes(self, items: list, section: str) -> bool:
        ok = True
        for item in items:
            if item.get("type") not in ("probe", None):
                continue
            if not self._exec_probe_item(item, section):
                ok = False
        return ok

    def _exec_steps(self, items: list, section: str) -> bool:
        ok = True
        for item in items:
            action = item.get("action", "")
            item_id = item.get("id", action or "step")

            if action == "wait":
                if self._exec_wait(item, section):
                    print(f"    OK:   {item_id}")
                else:
                    print(f"    FAIL: {item_id} (wait timed out)")
                    ok = False

            elif action.startswith("chaos."):
                if self._exec_chaos(item, section):
                    print(f"    OK:   {item_id}")
                else:
                    print(f"    FAIL: {item_id} ({action} failed)")
                    ok = False

            elif action in ("publish.service_package", "repository.promote",
                            "desired_state.upsert", "workflow.dispatch",
                            "backup.create", "backup.restore",
                            "node.recover.full_reseed"):
                print(f"    SKIP: {item_id} ({action} — not yet implemented)")

            elif item.get("probe"):
                # Step is actually a probe-style check
                if not self._exec_probe_item(item, section):
                    ok = False

            else:
                print(f"    SKIP: {item_id} (unknown action: {action})")

        return ok

    # ── probe execution ───────────────────────────────────────────────────────

    def _exec_probe_item(self, item: dict, section: str) -> bool:
        probe = item.get("probe", "")
        params = item.get("params", {}) or {}
        expect = item.get("expect", {}) or {}
        item_id = item.get("id") or probe or "probe"

        if not probe:
            print(f"    SKIP: {item_id} (no probe specified)")
            return True

        result = self._call_probe(probe, params)

        if self.verbose:
            print(f"    result: {json.dumps(result)}")

        if expect:
            passed, failures = self._check_expect(result, expect)
        else:
            # No expect — just a capture (baseline)
            passed = True
            failures = []
            self.baseline_captures[item_id] = result

        status = "PASS" if passed else "FAIL"
        print(f"    {status}: {item_id}")
        if not passed:
            for f in failures:
                print(f"      {f}")

        self.evidence.record(section, item_id, probe, params, expect, result, passed)
        return passed

    def _exec_wait(self, item: dict, section: str) -> bool:
        params = item.get("params", {}) or {}
        timeout = int(params.get("timeout", 60))
        poll_interval = int(params.get("poll_interval", 5))
        until = params.get("until") or {}
        item_id = item.get("id", "wait")

        if not until:
            # Plain sleep — honour the configured timeout
            print(f"    WAIT: {item_id} (sleeping {timeout}s)")
            time.sleep(timeout)
            return True

        probe = until.get("probe", "")
        probe_params = until.get("params", {}) or {}
        expect = until.get("expect", {}) or {}

        deadline = time.time() + timeout
        attempt = 0
        while time.time() < deadline:
            attempt += 1
            result = self._call_probe(probe, probe_params)
            passed, _ = self._check_expect(result, expect)
            if passed:
                self.evidence.record(
                    section, item_id, probe, probe_params, expect, result, True)
                return True
            remaining = int(deadline - time.time())
            print(f"    WAIT: {item_id} (attempt {attempt}, {remaining}s remaining)")
            time.sleep(poll_interval)

        result = self._call_probe(probe, probe_params)
        self.evidence.record(
            section, item_id, probe, probe_params, expect, result, False)
        return False

    # ── chaos execution ───────────────────────────────────────────────────────

    def _exec_chaos(self, item: dict, section: str) -> bool:
        """
        Execute a chaos action. Supported actions:
          chaos.stop_node      params: node (e.g. "node-4")
          chaos.detach_node_etcd params: node, self_ip, peer_ip (decommission: removes own member)
          chaos.start_node     params: node
          chaos.kill_service   params: node, service (systemd unit suffix)
          chaos.restart_service params: node, service
        All run docker commands on the host (not inside a container).
        """
        action = item.get("action", "")
        params = item.get("params", {}) or {}
        item_id = item.get("id", action)

        node = params.get("node", "")
        service = params.get("service", "")
        container = f"globular-{node}" if node else ""

        if self.verbose:
            print(f"    [chaos] {action} node={node} service={service}")

        try:
            if action == "chaos.stop_node":
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                # Use docker stop -t 10 so Docker sends SIGTERM then SIGKILL after 10s.
                # The compose stop_grace_period (30s) governs systemd shutdown, but for
                # chaos testing we want a fast, forced stop. Timeout 20s > -t 10 so the
                # Python subprocess never races the docker stop grace period.
                proc = subprocess.run(
                    ["docker", "stop", "-t", "10", container],
                    capture_output=True, text=True, timeout=20)
                ok = proc.returncode == 0
                if ok:
                    self._mutation_open("node_stopped", node=node)
                result = {"action": action, "container": container,
                          "exit_code": proc.returncode,
                          "stdout": proc.stdout.strip()[:100]}
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.start_node":
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                proc = subprocess.run(
                    ["docker", "start", container],
                    capture_output=True, text=True, timeout=30)
                ok = proc.returncode == 0
                result = {"action": action, "container": container,
                          "exit_code": proc.returncode,
                          "stdout": proc.stdout.strip()[:100]}
                if ok:
                    self._mutation_close("node_stopped", node=node)
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.detach_node_etcd":
                # Remove this node's OWN etcd member from the cluster, the way
                # clean-node.sh step 0.3 does before wiping a node.
                #
                # This is the decommission path, NOT a failure: after it runs the
                # member list must SHRINK, so the survivors' quorum requirement
                # drops with it. A node that is stopped without detaching stays
                # in the member list and keeps counting toward quorum forever —
                # that is what stranded the real cluster twice on 2026-07-30.
                #
                # Deliberately executed with the node's own etcd STOPPED, and
                # authenticating with the service cert rather than the etcd
                # client cert. Both were the real-world blockers: a node is
                # wiped after a failed join, so its etcd is already down and
                # pki/issued/etcd/ was never materialised.
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                peer = params.get("peer", "node-1")
                peer_ip = params.get("peer_ip", "10.10.0.11")
                self_ip = params.get("self_ip", "")
                if not self_ip:
                    return self._chaos_fail(section, item_id, action, params, "self_ip param required")
                # NOTE ON FAIL-CLOSED, learned the hard way in this very action:
                # the first version piped `member list` through 2>/dev/null, so a
                # lookup that could not run at all (etcdctl was not on PATH)
                # produced an empty ID and reported NOT_A_MEMBER — "the probe
                # could not answer" silently became "there is nothing to do".
                # That is the identical shape as the clean-node bug this scenario
                # exists to pin. A failed lookup must ERROR, never be read as
                # absence.
                script = (
                    "set -e; "
                    # The local etcd is deliberately LEFT RUNNING. clean-node.sh
                    # runs step 0.3 in Phase 0, BEFORE Phase 1 stops services,
                    # and that order is load-bearing: in a 2-member cluster,
                    # stopping this node's etcd first drops the survivors to
                    # 1-of-2, so the member-remove can no longer reach quorum to
                    # commit. It times out and the phantom member survives — the
                    # exact trap that made the live incident unrecoverable
                    # without --force-new-cluster.
                    "P=/var/lib/globular/pki; "
                    "ETCDCTL=''; "
                    "for c in /usr/lib/globular/bin/etcdctl /usr/local/bin/etcdctl "
                    "         /var/lib/globular/bin/etcdctl /usr/bin/etcdctl; do "
                    "  if [ -x \"$c\" ]; then ETCDCTL=$c; break; fi; done; "
                    "if [ -z \"$ETCDCTL\" ]; then ETCDCTL=$(command -v etcdctl || true); fi; "
                    "if [ -z \"$ETCDCTL\" ]; then echo 'ERROR: etcdctl not found'; exit 3; fi; "
                    # Service-cert fallback: a node wiped after a partial join has
                    # no pki/issued/etcd/. Mirrors services@b82bcbf9.
                    "C=$P/issued/etcd/client.crt; K=$P/issued/etcd/client.key; "
                    "if [ ! -f \"$C\" ] || [ ! -f \"$K\" ]; then "
                    "  C=$P/issued/services/service.crt; K=$P/issued/services/service.key; fi; "
                    "if [ ! -f \"$C\" ] || [ ! -f \"$K\" ]; then "
                    "  echo 'ERROR: no usable client cert'; exit 3; fi; "
                    f"E=https://{peer_ip}:2379; "
                    "LIST=$($ETCDCTL --endpoints=$E --command-timeout=15s "
                    "  --cacert=$P/ca.crt --cert=$C --key=$K member list 2>&1) "
                    "  || { echo \"ERROR: member list failed: $LIST\"; exit 3; }; "
                    f"ID=$(printf '%s\\n' \"$LIST\" | grep '{self_ip}' | cut -d, -f1); "
                    "if [ -z \"$ID\" ]; then echo 'NOT_A_MEMBER'; exit 0; fi; "
                    "$ETCDCTL --endpoints=$E --command-timeout=15s "
                    "  --cacert=$P/ca.crt --cert=$C --key=$K member remove $ID "
                    "  && echo DETACHED"
                )
                proc = subprocess.run(
                    ["docker", "exec", container, "bash", "-c", script],
                    capture_output=True, text=True, timeout=90)
                out = (proc.stdout or "").strip()
                ok = proc.returncode == 0 and "DETACHED" in out
                result = {"action": action, "container": container,
                          "exit_code": proc.returncode,
                          "stdout": out[-200:],
                          "stderr": (proc.stderr or "").strip()[-200:]}
                if ok:
                    # Carry the identity coordinates the reconstruction needs.
                    # The obligation has to be self-describing: teardown may run
                    # long after this action, from a failure path that never saw
                    # these params.
                    self._mutation_open("etcd_detached", node=node,
                                        self_ip=self_ip, peer_ip=peer_ip)
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.kill_service":
                # Graceful stop (SIGTERM). Use chaos.sigkill_service for SIGKILL.
                if not container or not service:
                    return self._chaos_fail(section, item_id, action, params, "node and service params required")
                # See chaos.restart_service: `unit:` names a non-Globular unit
                # such as ScyllaDB's upstream scylla-server.service.
                unit = params.get("unit") or f"globular-{service}.service"
                proc = subprocess.run(
                    ["docker", "exec", container, "systemctl", "stop", unit],
                    capture_output=True, text=True, timeout=30)
                ok = proc.returncode == 0
                result = {"action": action, "container": container, "unit": unit,
                          "exit_code": proc.returncode,
                          "stderr": proc.stderr.strip()[:200]}
                if ok:
                    self._mutation_open("service_killed", node=node, service=service, unit=unit)
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.sigkill_service":
                # Hard kill — sends SIGKILL to main process, triggering Restart=on-failure.
                if not container or not service:
                    return self._chaos_fail(section, item_id, action, params, "node and service params required")
                # See chaos.restart_service: `unit:` names a non-Globular unit.
                unit = params.get("unit") or f"globular-{service}.service"
                proc = subprocess.run(
                    ["docker", "exec", container, "systemctl", "kill",
                     "--kill-who=main", "-s", "KILL", unit],
                    capture_output=True, text=True, timeout=30)
                ok = proc.returncode == 0
                result = {"action": action, "container": container, "unit": unit,
                          "signal": "SIGKILL", "exit_code": proc.returncode,
                          "stderr": proc.stderr.strip()[:200]}
                if ok:
                    self._mutation_open("service_killed", node=node, service=service, unit=unit)
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.restart_service":
                if not container or not service:
                    return self._chaos_fail(section, item_id, action, params, "node and service params required")
                # Most units follow globular-<service>.service, but not all of
                # them: ScyllaDB ships upstream's scylla-server.service. An
                # explicit `unit:` lets a scenario name a non-Globular unit
                # instead of being restricted to what the prefix can express.
                unit = params.get("unit") or f"globular-{service}.service"
                # Use --no-block so systemctl returns immediately without waiting
                # for the service to reach 'active'. Services using Type=notify
                # (e.g. cluster-controller) may never reach 'active' if the binary
                # does not call sd_notify(READY=1) — causing systemctl to hang
                # indefinitely without --no-block.
                proc = subprocess.run(
                    ["docker", "exec", container, "systemctl", "restart", "--no-block", unit],
                    capture_output=True, text=True, timeout=30)
                ok = proc.returncode == 0
                result = {"action": action, "container": container, "unit": unit,
                          "exit_code": proc.returncode,
                          "stderr": proc.stderr.strip()[:200]}
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.fill_disk":
                # Fill disk on a node to a target usage percentage.
                # params: node, path (default /var/lib/globular), target_pct (default 95)
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                path = params.get("path", "/var/lib/globular")
                target_pct = int(params.get("target_pct", 95))
                # Reserve the space with fallocate, which returns immediately,
                # and only fall back to dd where the filesystem cannot allocate
                # without writing.
                #
                # dd alone was the original implementation: filling a
                # multi-gigabyte volume a megabyte at a time cannot finish
                # inside the step budget, so the action reported "timed out"
                # and disk-pressure-detection never got to test detection at
                # all — it failed on how the pressure was created.
                # Never leave the filesystem with less than this much room,
                # whatever target_pct asks for.
                #
                # In this topology every container shares the HOST filesystem,
                # so "fill node-3 to 95%" fills the developer's disk to 95%.
                # At that point docker, the build cache and the containers are
                # all fighting over the remainder and an unrelated crash is a
                # plausible outcome — the scenario wants disk PRESSURE, not a
                # wedged machine. The floor bounds the blast radius; if the
                # disk is already below it the fill becomes a no-op and the
                # scenario reports what it could not do rather than pushing the
                # host over the edge.
                floor_mb = int(params.get("min_free_mb", 12288))  # 12 GiB
                fill_cmd = (
                    f"set -e; "
                    f"read -r AVAIL TARGET < <(df -m {path} | awk 'NR==2{{print $4, int($2*{target_pct}/100)-$3}}'); "
                    f"FILL=$TARGET; "
                    f"MAX=$(( AVAIL - {floor_mb} )); "
                    f"if [ \"$MAX\" -lt 0 ]; then MAX=0; fi; "
                    f"if [ \"$FILL\" -gt \"$MAX\" ]; then FILL=$MAX; fi; "
                    f"if [ \"$FILL\" -le 0 ]; then "
                    f"echo \"fill skipped: only ${{AVAIL}}MiB free, floor is {floor_mb}MiB\" >&2; exit 0; fi; "
                    f"fallocate -l \"${{FILL}}M\" {path}/.chaos-fill 2>/dev/null "
                    f"|| dd if=/dev/zero of={path}/.chaos-fill bs=1M count=\"$FILL\" status=none"
                )
                proc = subprocess.run(
                    ["docker", "exec", container, "bash", "-c", fill_cmd],
                    capture_output=True, text=True, timeout=120)
                ok = proc.returncode == 0
                result = {"action": action, "container": container, "path": path,
                          "target_pct": target_pct, "exit_code": proc.returncode,
                          "stderr": proc.stderr.strip()[:200]}
                if ok:
                    self._mutation_open("disk_filled", node=node, path=params.get("path", "/var/lib/globular/chaos-fill"))
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.clear_disk_fill":
                # Remove the chaos fill file created by chaos.fill_disk.
                # params: node, path (default /var/lib/globular)
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                path = params.get("path", "/var/lib/globular")
                proc = subprocess.run(
                    ["docker", "exec", container, "rm", "-f", f"{path}/.chaos-fill"],
                    capture_output=True, text=True, timeout=15)
                ok = proc.returncode == 0
                result = {"action": action, "container": container,
                          "exit_code": proc.returncode}
                if ok:
                    self._mutation_close("disk_filled", node=node, path=params.get("path", "/var/lib/globular/chaos-fill"))
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.block_network":
                # Block all traffic between a node and the rest of the cluster using iptables.
                # params: node, direction (in|out|both, default both)
                # Requires the container to run with NET_ADMIN capability.
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                direction = params.get("direction", "both")
                cmds = []
                if direction in ("out", "both"):
                    cmds.append("iptables -I OUTPUT -j DROP")
                if direction in ("in", "both"):
                    cmds.append("iptables -I INPUT -j DROP")
                # Allow loopback so the node keeps working internally while it
                # is cut off from its peers — a network partition, not a dead
                # node.
                #
                # These MUST run last. `-I` inserts at the TOP of the chain, so
                # whichever rule is added last wins. Adding the loopback ACCEPTs
                # first (the previous order) put the DROP above them, which
                # dropped loopback as well and broke the node's own local
                # traffic — a harsher fault than the scenario describes.
                cmds.append("iptables -I OUTPUT -o lo -j ACCEPT")
                cmds.append("iptables -I INPUT -i lo -j ACCEPT")
                cmd = " && ".join(cmds)
                proc = subprocess.run(
                    ["docker", "exec", "--privileged", container, "bash", "-c", cmd],
                    capture_output=True, text=True, timeout=15)
                ok = proc.returncode == 0
                result = {"action": action, "container": container, "direction": direction,
                          "exit_code": proc.returncode, "stderr": proc.stderr.strip()[:200]}
                if ok:
                    self._mutation_open("network_blocked", node=node)
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.unblock_network":
                # Remove iptables DROP rules inserted by chaos.block_network.
                # params: node
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                cmd = "iptables -F INPUT; iptables -F OUTPUT"
                proc = subprocess.run(
                    ["docker", "exec", "--privileged", container, "bash", "-c", cmd],
                    capture_output=True, text=True, timeout=15)
                ok = proc.returncode == 0
                result = {"action": action, "container": container,
                          "exit_code": proc.returncode, "stderr": proc.stderr.strip()[:200]}
                if ok:
                    self._mutation_close("network_blocked", node=node)
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.inject_expired_cert":
                # Replace the node's TLS service cert with an expired self-signed cert.
                # The original is saved as service.crt.chaos-backup for restoration.
                # params: node, cert_path (default /var/lib/globular/pki/issued/services/service.crt),
                #         key_path (default /var/lib/globular/pki/issued/services/service.key)
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                cert_path = params.get("cert_path", "/var/lib/globular/pki/issued/services/service.crt")
                key_path = params.get("key_path", "/var/lib/globular/pki/issued/services/service.key")
                # Generate an expired cert (not before/after both in the past)
                # `cp -p` is load-bearing: docker exec runs as root, so a plain
                # `cp` writes a root:root backup and DESTROYS the original
                # globular:globular ownership. Restore then `mv`s that root-owned
                # file back, and every service running as `globular` loses the
                # ability to read its own key. Observed 2026-08-05: node-3's etcd
                # went on rejecting every TLS connection with
                # "open .../service.key: permission denied" long after the
                # scenario had "restored" the cert, which silently took the node
                # out of the etcd quorum for all later suites.
                # The cert MUST come out genuinely expired — that is the whole
                # fault being injected.
                #
                # The previous implementation wrote a `-days 1` cert and then
                # tried to overwrite it with `-days 0`, suffixed `|| true`.
                # OpenSSL 3.0 rejects that outright ("req: Non-positive number
                # \"0\" for option -days"), so the failure was swallowed and the
                # VALID one-day cert stayed in place. The scenario then asserted
                # `expired: true` against a cert with ~24h left and failed on its
                # own fixture — meaning cert-expiry repair was never actually
                # exercised, on any run, while the suite reported a real failure.
                #
                # `-not_before`/`-not_after` would be the direct fix but only
                # exist from OpenSSL 3.5; the nodes ship 3.0.13. `openssl ca`
                # has honoured explicit -startdate/-enddate for far longer, so
                # sign through a throwaway CA with both dates in the past. No
                # `|| true` anywhere: if injection cannot happen, the step must
                # fail loudly rather than hand the assertions a healthy cert.
                gen_cmd = (
                    f"set -e; "
                    f"cp -p {cert_path} {cert_path}.chaos-backup; "
                    f"cp -p {key_path} {key_path}.chaos-backup; "
                    f"T=$(mktemp -d); "
                    f"openssl req -x509 -newkey rsa:2048 -keyout $T/ca.key -out $T/ca.crt "
                    f"-nodes -subj '/CN=chaos-ca' -days 3650 2>/dev/null; "
                    f"openssl req -newkey rsa:2048 -keyout $T/svc.key -out $T/svc.csr "
                    f"-nodes -subj '/CN=chaos-expired' 2>/dev/null; "
                    f"mkdir -p $T/ca/newcerts; : > $T/ca/index.txt; echo 01 > $T/ca/serial; "
                    f"printf '%s\\n' "
                    f"'[ca]' 'default_ca = d' '[d]' \"dir = $T/ca\" "
                    f"'database = $dir/index.txt' 'serial = $dir/serial' "
                    f"'new_certs_dir = $dir/newcerts' 'default_md = sha256' "
                    f"'policy = pol' 'email_in_dn = no' 'rand_serial = no' "
                    f"'unique_subject = no' '[pol]' 'commonName = supplied' > $T/ca.cnf; "
                    f"openssl ca -batch -config $T/ca.cnf -cert $T/ca.crt -keyfile $T/ca.key "
                    f"-in $T/svc.csr -out $T/svc.crt -notext "
                    f"-startdate 20250101000000Z -enddate 20250102000000Z 2>/dev/null; "
                    # Fail closed: refuse to install a cert that is not expired.
                    f"openssl x509 -in $T/svc.crt -checkend 0 >/dev/null 2>&1 && "
                    f"{{ echo 'chaos: generated cert is not expired' >&2; exit 1; }}; "
                    # Install over the real cert/key, preserving ownership+mode.
                    f"cat $T/svc.crt > {cert_path}; cat $T/svc.key > {key_path}; "
                    f"rm -rf $T"
                )
                proc = subprocess.run(
                    ["docker", "exec", container, "bash", "-c", gen_cmd],
                    capture_output=True, text=True, timeout=30)
                ok = proc.returncode == 0
                result = {"action": action, "container": container, "cert_path": cert_path,
                          "exit_code": proc.returncode, "stderr": proc.stderr.strip()[:300]}
                if ok:
                    self._mutation_open("cert_injected", node=node)
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.restore_cert":
                # Restore the original cert after chaos.inject_expired_cert.
                # params: node, cert_path, key_path
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                cert_path = params.get("cert_path", "/var/lib/globular/pki/issued/services/service.crt")
                key_path = params.get("key_path", "/var/lib/globular/pki/issued/services/service.key")
                # Restoration must be VERIFIED, not assumed. The old command ended
                # in `true`, so `ok` was always True — a restore that left the
                # node's key unreadable reported success and the contamination
                # rode into every later scenario. Now: put the files back, prove
                # no backup remains, and prove the service account can actually
                # READ the key (which is the property that actually matters —
                # ownership alone is a proxy).
                svc_user = params.get("service_user", "globular")
                restore_cmd = (
                    f"set -e; "
                    f"if [[ -f {cert_path}.chaos-backup ]]; then mv {cert_path}.chaos-backup {cert_path}; fi; "
                    f"if [[ -f {key_path}.chaos-backup ]]; then mv {key_path}.chaos-backup {key_path}; fi; "
                    # No leftovers.
                    f"if [[ -e {cert_path}.chaos-backup || -e {key_path}.chaos-backup ]]; then "
                    f"  echo 'VERIFY_FAIL leftover chaos-backup'; exit 1; fi; "
                    # Files present.
                    f"if [[ ! -f {cert_path} || ! -f {key_path} ]]; then "
                    f"  echo 'VERIFY_FAIL cert or key missing after restore'; exit 1; fi; "
                    # The property that matters: the service account can read the key.
                    f"if ! su -s /bin/sh -c 'test -r {key_path}' {svc_user}; then "
                    f"  echo \"VERIFY_FAIL {svc_user} cannot read $(stat -c '%n owner=%U:%G mode=%a' {key_path})\"; exit 1; fi; "
                    f"echo \"VERIFY_OK $(stat -c 'key=%U:%G/%a' {key_path}) $(stat -c 'crt=%U:%G/%a' {cert_path})\""
                )
                proc = subprocess.run(
                    ["docker", "exec", container, "bash", "-c", restore_cmd],
                    capture_output=True, text=True, timeout=30)
                out = (proc.stdout or "").strip()
                ok = proc.returncode == 0 and "VERIFY_OK" in out
                result = {"action": action, "container": container,
                          "exit_code": proc.returncode,
                          "verification": out[-300:],
                          "stderr": (proc.stderr or "").strip()[:300]}
                if ok:
                    self._mutation_close("cert_injected", node=node)
                if not ok:
                    print(f"    CLEANUP FAILED: {item_id} ({action}) — {out or proc.stderr.strip()}")
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action in ("chaos.inflate_etcd", "chaos.deflate_etcd"):
                # Grow etcd's backend past the node-agent maintenance floor so a
                # defrag has something real to reclaim — then hand it back.
                #
                # Writing then DELETING the keys is the point: deleted revisions
                # become free pages once compaction runs, which is exactly the
                # state the 2026-08-16 outage lived in — a large file that is
                # mostly reclaimable. Compaction alone never shrinks the file;
                # only a defrag returns the space to the filesystem.
                #
                # Two mechanics worth keeping: etcd binds listen-client-urls to
                # the node's interface address and NOT loopback, so the endpoint
                # is read from etcd's own config rather than assumed; and a
                # 350 KB value cannot be passed in argv (MAX_ARG_STRLEN, "Argument
                # list too long"), so values are fed from a file on stdin.
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                mb = int(params.get("mb", 300))
                inflating = action == "chaos.inflate_etcd"

                preamble = (
                    'set -e\n'
                    'EP=$(sed -n "s|^advertise-client-urls:[[:space:]]*\\"\\{0,1\\}\\([^\\"]*\\)\\"\\{0,1\\}$|\\1|p" '
                    '/var/lib/globular/config/etcd.yaml | head -1)\n'
                    'PKI=/var/lib/globular/pki\n'
                    'E="/usr/lib/globular/bin/etcdctl --endpoints=$EP --cacert=$PKI/ca.crt '
                    '--cert=$PKI/issued/services/service.crt --key=$PKI/issued/services/service.key"\n'
                )
                if inflating:
                    body = (
                        'head -c 262144 /dev/urandom | base64 -w0 > /tmp/.inflate_blob\n'
                        f'N=$(( {mb} * 4 ))\n'
                        'for i in $(seq 1 $N); do $E put "/globular/test/inflate/$i" < /tmp/.inflate_blob >/dev/null; done\n'
                        'rm -f /tmp/.inflate_blob\n'
                        '$E del --prefix /globular/test/inflate/ >/dev/null\n'
                        'REV=$($E endpoint status -w fields | sed -n \'s/^"Revision" : //p\' | head -1)\n'
                        '$E compact "$REV" --physical >/dev/null 2>&1 || true\n'
                        '$E endpoint status -w fields | sed -n \'s/^"DBSize" : /DBSIZE=/p\' | head -1\n'
                    )
                else:
                    body = (
                        '$E del --prefix /globular/test/inflate/ >/dev/null 2>&1 || true\n'
                        'REV=$($E endpoint status -w fields | sed -n \'s/^"Revision" : //p\' | head -1)\n'
                        '$E compact "$REV" --physical >/dev/null 2>&1 || true\n'
                        'for ip in 11 12 13 14 15; do '
                        '$E --endpoints=https://10.10.0.$ip:2379 defrag --command-timeout=300s >/dev/null 2>&1 || true; done\n'
                        '$E alarm disarm >/dev/null 2>&1 || true\n'
                        '$E endpoint status -w fields | sed -n \'s/^"DBSize" : /DBSIZE=/p\' | head -1\n'
                    )

                proc = subprocess.run(
                    ["docker", "exec", container, "bash", "-c", preamble + body],
                    capture_output=True, text=True, timeout=1800)
                out = (proc.stdout or "").strip()
                ok = proc.returncode == 0
                if ok:
                    if inflating:
                        self._mutation_open("etcd_inflated", node=node)
                    else:
                        self._mutation_close("etcd_inflated", node=node)
                result = {"action": action, "container": container, "mb": mb if inflating else None,
                          "exit_code": proc.returncode, "db_size": out[-80:],
                          "stderr": (proc.stderr or "").strip()[-300:]}
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "ops.set_desired":
                # Drive desired state through the CLI, the way an operator does.
                #
                # `expect` makes this an action that can FAIL on the wrong
                # outcome: expect=refused passes only when the control plane
                # rejects the request. That matters because the interesting
                # safety properties here are refusals — pointing desired state
                # at something unresolvable, or regressing without the audited
                # flag — and a refusal that silently succeeded would be the
                # worst possible outcome to record as a pass.
                name = params.get("name", "")
                version = params.get("version", "")
                expect = params.get("expect", "accepted")
                node_c = f"globular-{params.get('node', 'node-1')}"
                if not name or not version:
                    return self._chaos_fail(section, item_id, action, params, "name and version params required")
                cmd = f"globular services desired set {name} {version}"
                if params.get("allow_regression"):
                    cmd += " --allow-regression"
                proc = subprocess.run(
                    ["docker", "exec", node_c, "bash", "-c", cmd + " 2>&1"],
                    capture_output=True, text=True, timeout=180)
                out = (proc.stdout or "").strip()
                accepted = proc.returncode == 0
                ok = accepted if expect == "accepted" else (not accepted)
                result = {"action": action, "service": name, "version": version,
                          "expect": expect, "accepted": accepted,
                          "exit_code": proc.returncode, "output": out[-400:]}
                if not ok:
                    print(f"    {item_id}: expected {expect}, got "
                          f"{'accepted' if accepted else 'refused'} — {out[-200:]}")
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "ops.remove_node":
                # Remove a node's identity from the CONTROLLER, not just its
                # local state.
                #
                # Wiping /var/lib/globular makes a node forget the cluster; it
                # does not make the cluster forget the node. The controller
                # still holds its record, so the next join is correctly refused:
                #
                #     join blocked: controller denied — node identity conflict:
                #     hostname already present
                #
                # A genuine FIRST join therefore needs both halves. This is the
                # cluster-side half, and it is the step clean-node.sh expects an
                # operator to have performed.
                node_c = f"globular-{params.get('runner', 'node-1')}"
                target = params.get("node", "")
                if not target:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                # Resolve the node UUID from the target container, since the
                # controller keys nodes by id and not by container name.
                idp = subprocess.run(
                    ["docker", "exec", f"globular-{target}", "bash", "-c",
                     "cat /var/lib/globular/node-agent/state.json 2>/dev/null || "
                     "cat /var/lib/globular/nodeagent/state.json 2>/dev/null"],
                    capture_output=True, text=True, timeout=60)
                node_id = ""
                try:
                    node_id = (json.loads(idp.stdout or "{}") or {}).get("node_id", "")
                except Exception:
                    node_id = ""
                if not node_id:
                    node_id = params.get("node_id", "")
                if not node_id:
                    return self._chaos_fail(section, item_id, action, params,
                                            f"could not resolve a node_id for {target}")
                proc = subprocess.run(
                    ["docker", "exec", node_c, "bash", "-c",
                     f"globular cluster nodes remove {node_id} --force --drain=false 2>&1"],
                    capture_output=True, text=True, timeout=300)
                out = (proc.stdout or "").strip()
                ok = proc.returncode == 0
                if ok:
                    self._mutation_open("node_removed", node=target)
                result = {"action": action, "node": target, "node_id": node_id,
                          "exit_code": proc.returncode, "output": out[-400:]}
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            elif action == "chaos.wipe_node_state":
                # Wipe a node back to pre-install so its next start is a genuine
                # FIRST join, not a re-join.
                #
                # The distinction is not academic: the bootstrap unit short-
                # circuits on a "already bootstrapped" marker in the state
                # volume, so a node whose volume survives never exercises the
                # join path at all. On 2026-08-17 that is exactly how four nodes
                # appeared to "join" while running no services.
                if not container:
                    return self._chaos_fail(section, item_id, action, params, "node param required")
                stop = subprocess.run(["docker", "stop", "-t", "15", container],
                                      capture_output=True, text=True, timeout=40)
                wipe = subprocess.run(
                    ["docker", "run", "--rm",
                     "-v", f"globular-quickstart_{node.replace('-', '')}-state:/state",
                     "alpine:3", "sh", "-c", "rm -rf /state/* /state/.[!.]* 2>/dev/null; ls -A /state | wc -l"],
                    capture_output=True, text=True, timeout=180)
                remaining = (wipe.stdout or "").strip().splitlines()[-1:] or ["?"]
                ok = stop.returncode == 0 and wipe.returncode == 0
                if ok:
                    self._mutation_open("node_wiped", node=node)
                result = {"action": action, "container": container,
                          "stop_exit": stop.returncode, "wipe_exit": wipe.returncode,
                          "entries_left_in_state": remaining[0],
                          "stderr": (wipe.stderr or "").strip()[-200:]}
                self.evidence.record(section, item_id, action, params, {}, result, ok)
                return ok

            else:
                # An unknown action used to return True — so a typo in an action
                # name silently skipped the mutation and the scenario still
                # reported PASS, asserting a steady state it never disturbed.
                # A scenario that cannot perform its own setup has not passed.
                return self._chaos_fail(section, item_id, action, params,
                                        f"unknown action '{action}' — check the name against "
                                        "the dispatch list in globular-scenario")

        except subprocess.TimeoutExpired:
            return self._chaos_fail(section, item_id, action, params, "timed out after 30s")
        except Exception as e:
            return self._chaos_fail(section, item_id, action, params, str(e))

    # ── post-scenario health gate ────────────────────────────────────────────

    ETCDCTL = ("/usr/lib/globular/bin/etcdctl "
               "--cacert=/var/lib/globular/pki/ca.crt "
               "--cert=/var/lib/globular/pki/issued/services/service.crt "
               "--key=/var/lib/globular/pki/issued/services/service.key ")
    ALL_EPS = ",".join(f"https://10.10.0.1{i}:2379" for i in range(1, 6))
    NODES = [f"node-{i}" for i in range(1, 6)]

    def _health_fingerprint(self) -> dict:
        """
        Canonical, cheap, high-signal snapshot of the cluster's structural state.

        The mutation ledger can only detect mutations the harness itself made.
        This catches everything else: emergent damage and side effects nobody
        declared. It deliberately includes cert ownership/mode and service-account
        readability, because that is the exact shape that took node-3's etcd out
        of the quorum on 2026-08-05 while systemd still reported the unit active
        — bytes restored, ownership not.
        """
        fp: dict = {}
        running = self._sh(["docker", "ps", "--filter", "name=globular-node",
                            "--format", "{{.Names}}"], timeout=30).stdout.split()
        fp["containers_running"] = sorted(running)

        live = None
        for n in self.NODES:
            if f"globular-{n}" in running:
                live = f"globular-{n}"
                break
        if live:
            h = self._sh(["docker", "exec", live, "bash", "-c",
                          f"{self.ETCDCTL} --endpoints={self.ALL_EPS} endpoint health --cluster 2>&1"],
                         timeout=90).stdout
            fp["etcd_healthy_endpoints"] = h.count("is healthy")
            m = self._sh(["docker", "exec", live, "bash", "-c",
                          f"{self.ETCDCTL} --endpoints=https://10.10.0.11:2379 member list 2>/dev/null | wc -l"],
                         timeout=60).stdout.strip()
            fp["etcd_member_count"] = m
        else:
            fp["etcd_healthy_endpoints"] = 0
            fp["etcd_member_count"] = "0"

        # Per-node PKI posture + the property that actually matters: can the
        # service account READ its key. Ownership alone is only a proxy.
        pki = {}
        for n in self.NODES:
            c = f"globular-{n}"
            if c not in running:
                pki[n] = "node-not-running"
                continue
            out = self._sh(["docker", "exec", c, "bash", "-c",
                            "K=/var/lib/globular/pki/issued/services/service.key; "
                            "S=$(stat -c '%U:%G/%a' $K 2>/dev/null || echo missing); "
                            "R=$(su -s /bin/sh -c \"test -r $K\" globular >/dev/null 2>&1 && echo readable || echo UNREADABLE); "
                            "B=$(ls /var/lib/globular/pki/issued/services/*.chaos-backup 2>/dev/null | wc -l); "
                            "echo \"$S $R backups=$B\""], timeout=45).stdout.strip()
            pki[n] = out or "probe-failed"
        fp["pki"] = pki
        return fp

    def _fingerprint_diff(self, base: dict, now: dict) -> list:
        diffs = []
        for k in sorted(set(base) | set(now)):
            b, n = base.get(k), now.get(k)
            if b != n:
                diffs.append(f"{k}: baseline={b!r} now={n!r}")
        return diffs

    def _verify_postconditions(self, timeout: int = 120) -> bool:
        """
        Bounded-convergence postcondition gate. Runs after steps, declared
        cleanup, and ledger enforcement.

        Semantics (deliberately distinct from RESIDUE):
          ledger residue found + repaired      -> RESIDUE failure      (handled above)
          ledger clean, cluster unhealthy      -> POSTCONDITION failure (here)
          ledger clean, converges healthy      -> pass
        A cluster that heals on its own inside the window is fine; a cluster that
        never returns to its captured structural state is not, no matter how
        green the scenario's own assertions were.
        """
        base = self.baseline_captures.get("_health_fingerprint")
        if not base:
            # No baseline means the cluster was unreachable when the scenario
            # started, so there is nothing to compare against. That is UNPROVEN,
            # not proven-good. Returning True here would hand a green
            # postcondition to precisely the runs least able to earn one — the
            # same "absence of evidence read as evidence of absence" shape the
            # doctor's reduced-harvest policy exists to prevent.
            print("  POSTCONDITION: UNPROVEN — no baseline fingerprint was "
                  "captured (cluster unreachable at scenario start)")
            self.evidence.record("postconditions", "cluster_returned_to_baseline",
                                 "health.fingerprint", {}, {"diffs": []},
                                 {"unproven": "no baseline captured"}, False)
            return False
        deadline = time.time() + timeout
        diffs, now = [], {}
        while True:
            now = self._health_fingerprint()
            diffs = self._fingerprint_diff(base, now)
            if not diffs or time.time() >= deadline:
                break
            time.sleep(10)
        ok = not diffs
        self.evidence.record("postconditions", "cluster_returned_to_baseline",
                             "health.fingerprint", {"timeout_s": timeout},
                             {"diffs": []},
                             {"baseline": base, "final": now, "diffs": diffs}, ok)
        if not ok:
            print(f"  POSTCONDITION: cluster did not return to its captured state "
                  f"within {timeout}s:")
            for d in diffs:
                print(f"    {d}")
        return ok

    # ── mutation ledger ──────────────────────────────────────────────────────
    #
    # Restoration MODES. A mutation is not simply "reversible or not" — putting
    # the world back can restore capability without restoring identity, and
    # conflating the two is how a harness ends up claiming an inverse it did not
    # actually perform.
    #
    #   EXACT_RESTORATION         the original object is back, identity intact
    #                             (a stopped container restarted is the same
    #                             container; a cert moved back is the same cert)
    #
    #   EQUIVALENT_RECONSTRUCTION capability restored, identity NOT. The thing
    #                             that exists now is a new object playing the
    #                             same role. Re-adding a detached etcd member
    #                             yields a NEW member ID — so it is emphatically
    #                             not an inverse, and must never be recorded as
    #                             one. Same shape as recreating a container,
    #                             regenerating a certificate, replacing a disk
    #                             replica, or rebuilding an index.
    #
    #   UNRESTORABLE              the harness cannot put this back at all. Fail
    #                             loudly; do not let the scenario participate in
    #                             an unattended suite as though it were safe.
    #
    # Anything claiming EQUIVALENT_RECONSTRUCTION owes explicit verification of
    # the role it claims to have rebuilt, because "it works again" is a weaker
    # statement than "it is the same thing".
    EXACT_RESTORATION = "EXACT_RESTORATION"
    EQUIVALENT_RECONSTRUCTION = "EQUIVALENT_RECONSTRUCTION"
    UNRESTORABLE = "UNRESTORABLE"

    # How each tracked mutation can be undone, if at all.
    RESTORATION_MODE = {
        "node_stopped":    EXACT_RESTORATION,
        "network_blocked": EXACT_RESTORATION,
        "disk_filled":     EXACT_RESTORATION,
        "cert_injected":   EXACT_RESTORATION,
        # etcd content is 100% rebuildable from ground, so nothing about etcd is
        # ever irreversibly lost and UNRESTORABLE is the wrong disposition:
        #   - a detached member's DATA never needed preserving — it re-syncs from
        #     the surviving quorum;
        #   - --repair-etcd backs up and wipes the local data dir, then rejoins;
        #   - even total loss rebuilds: Day-0 seeds desired state from installed
        #     packages, workflow definitions from local disk, RBAC from generated
        #     policy, and cluster.invariant.enforcement's repair_missing_workflows
        #     re-seeds etcd from disk as an in-product self-heal.
        # It is EQUIVALENT_RECONSTRUCTION rather than EXACT_RESTORATION only
        # because the rebuilt member gets a NEW etcd member id — capability
        # returns, identity does not.
        # Mode is EQUIVALENT_RECONSTRUCTION in principle (etcd content is fully
        # rebuildable; only the member id changes). Declared UNRESTORABLE in
        # practice until reconstruction is proven safe on partial failure — see
        # the phantom-member note in _enforce_restoration.
        "etcd_detached":   UNRESTORABLE,
        # Service kills: the product is supposed to bring these back (node-agent
        # convergence / systemd Restart=). The obligation is therefore not "run
        # an inverse" but "prove recovery actually happened" — an assumed
        # recovery that silently did not occur is how a dead service rides into
        # the next scenario.
        "service_killed":  EXACT_RESTORATION,
    }

    def _mutation_open(self, kind: str, **key) -> None:
        """Record that a destructive mutation is now outstanding."""
        entry = {"kind": kind, **key}
        if entry not in self.outstanding:
            self.outstanding.append(entry)

    def _mutation_close(self, kind: str, **key) -> None:
        """
        Record that a mutation's obligation is satisfied.

        Matches on the SUBSET of keys given, not on exact dict equality: an
        obligation may carry extra diagnostic fields the closer never saw (the
        etcd one carries self_ip/peer_ip so teardown can reconstruct without the
        original params). Requiring the closer to reproduce every field would
        silently leave obligations open and report phantom residue.
        """
        want = {"kind": kind, **key}
        for entry in list(self.outstanding):
            if all(entry.get(k) == v for k, v in want.items()):
                self.outstanding.remove(entry)

    def _sh(self, argv: list, timeout: int = 60, cwd: str = None):
        return subprocess.run(argv, capture_output=True, text=True,
                              timeout=timeout, cwd=cwd)

    def _enforce_restoration(self) -> bool:
        """
        Reverse every mutation the scenario left outstanding, then PROVE the
        reversal. Runs after `cleanup`, whether the scenario passed, failed, or
        stopped early.

        A successful mutation followed by an unverified cleanup is still a failed
        scenario, so this returns False on any residue it cannot both reverse and
        verify. Some mutations have no inverse the harness can perform (etcd
        member detach); those are reported as UNRESTORABLE rather than silently
        tolerated, because that is exactly the residue that took node-2/node-3
        out of quorum for every later suite on 2026-08-05.
        """
        report = {"outstanding_at_teardown": list(self.outstanding),
                  "reversed": [], "discharged": [], "failed": [], "unrestorable": []}
        if not self.outstanding:
            self.restoration_report = report
            return True

        print(f"  [restore] {len(self.outstanding)} outstanding mutation(s) — reversing")
        for entry in list(self.outstanding):
            kind = entry.get("kind")
            # Only self-healing obligations set this; everything else stays False
            # so the generic "we reversed it ourselves" path applies.
            self_healed = False
            node = entry.get("node", "")
            container = f"globular-{node}" if node else ""
            try:
                if kind == "node_stopped":
                    self._sh(["docker", "start", container], timeout=90)
                    ok = self._sh(["docker", "inspect", "-f", "{{.State.Running}}",
                                   container], timeout=30).stdout.strip() == "true"
                elif kind == "network_blocked":
                    self._sh(["docker", "exec", container, "bash", "-c",
                              "iptables -F INPUT; iptables -F OUTPUT; true"], timeout=45)
                    ok = self._sh(["docker", "exec", container, "bash", "-c",
                                   "iptables -S INPUT | grep -qc DROP && exit 1 || exit 0"],
                                  timeout=45).returncode == 0
                elif kind == "disk_filled":
                    path = entry.get("path", "/var/lib/globular/chaos-fill")
                    self._sh(["docker", "exec", container, "bash", "-c",
                              f"rm -f {path}; true"], timeout=45)
                    ok = self._sh(["docker", "exec", container, "bash", "-c",
                                   f"test ! -e {path}"], timeout=30).returncode == 0
                elif kind == "service_killed":
                    # SELF-HEALING obligation. The contract here is "prove
                    # recovery happened", not "run an inverse", so an obligation
                    # still open at teardown is NOT automatically residue: if the
                    # product restarted the service as designed, the obligation
                    # is DISCHARGED and the scenario is clean. Residue is only
                    # the case where the product did not recover and the harness
                    # had to intervene — which is a real product finding, not
                    # scenario sloppiness. Conflating the two would fail every
                    # correct crash-recovery scenario in the suite.
                    # The product is supposed to restart this itself. Give
                    # convergence a bounded window and PROVE it happened; only
                    # intervene if it did not. An assumed recovery that silently
                    # failed is how a dead service reaches the next scenario,
                    # and "systemd active" alone was already shown to be
                    # insufficient evidence (node-3's etcd was active and
                    # non-functional), so this also waits for the unit to be
                    # active rather than merely present.
                    # Use the unit the chaos action actually stopped. Rebuilding
                    # it as globular-<service> is wrong for units that do not
                    # carry that prefix — ScyllaDB ships scylla-server.service —
                    # and the restoration then polled a unit that does not
                    # exist, reported "did not self-recover", and failed the
                    # scenario with residue while the real service was fine.
                    unit = entry.get("unit") or f"globular-{entry.get('service','')}"
                    ok = False
                    for _ in range(12):  # ~60s
                        st = self._sh(["docker", "exec", container, "systemctl",
                                       "is-active", unit], timeout=30).stdout.strip()
                        if st == "active":
                            ok = True
                            self_healed = True
                            break
                        time.sleep(5)
                    if not ok:
                        print(f"    {unit} did not self-recover — the product "
                              f"failed to restart it; starting it so the next "
                              f"scenario is not poisoned, and failing this one.")
                        self._sh(["docker", "exec", container, "systemctl",
                                  "start", unit], timeout=60)
                        st = self._sh(["docker", "exec", container, "systemctl",
                                       "is-active", unit], timeout=30).stdout.strip()
                        ok = (st == "active")
                elif kind == "cert_injected":
                    # Reuse the verified restore path (ownership + readability).
                    ok = self._exec_chaos(
                        {"id": "auto-restore-cert", "action": "chaos.restore_cert",
                         "params": {"node": node}}, "restoration")
                elif kind == "etcd_detached":
                    # DELIBERATELY NOT auto-reconstructed. chaos.reconstruct_
                    # node_etcd_membership exists and is wired, but it is NOT
                    # proven and must not run unattended, because a PARTIAL
                    # failure leaves the cluster worse than it found it:
                    #
                    #   member add succeeds -> node fails to start
                    #   -> phantom "unstarted" member persists
                    #   -> phantom counts toward quorum (2-of-3 becomes 3-of-4)
                    #   -> next rejoin: "learner slot contended ...
                    #      etcdserver: unhealthy cluster" -> another phantom
                    #
                    # Observed 2026-08-05 with member a255b6c28231fd7b; recovery
                    # required a manual `member remove`. A cleanup path that can
                    # degrade the cluster on partial failure is worse than no
                    # cleanup path, because unattended suites amplify it.
                    #
                    # Fail loudly instead. Re-enable only once the operation can
                    # add-and-verify-started atomically and roll the member add
                    # back when the node does not come up — that rollback is
                    # exactly what would have prevented the phantom.
                    report["unrestorable"].append(
                        {**entry, "mode": self.UNRESTORABLE,
                         "reason": "reconstruction unproven; partial failure creates "
                                   "quorum-inflating phantom members"})
                    print(f"    UNRESTORABLE: {entry} — etcd membership reconstruction "
                          f"is not suite-safe (partial failure leaves a phantom member "
                          f"that inflates quorum and blocks the next rejoin). Repair "
                          f"this node with the operator path before the next run.")
                    continue
                elif self.RESTORATION_MODE.get(kind) == self.UNRESTORABLE:
                    report["unrestorable"].append({**entry, "mode": self.UNRESTORABLE})
                    print(f"    UNRESTORABLE: {entry} — no harness inverse exists. "
                          f"Re-adding would be EQUIVALENT_RECONSTRUCTION (new member "
                          f"identity), not restoration, and etcd membership repair is "
                          f"an operator-governed path (--repair-etcd). The cluster is "
                          f"left degraded ON PURPOSE and this scenario is failed, "
                          f"rather than leaking a 4/5 cluster into the next scenario.")
                    continue
                else:
                    report["unrestorable"].append(
                        {**entry, "mode": "UNKNOWN_MUTATION_KIND"})
                    print(f"    UNRESTORABLE: {entry} — no declared restoration mode. "
                          f"Add it to RESTORATION_MODE; an untracked mutation kind "
                          f"must not silently pass as restored.")
                    continue
                if ok and self_healed:
                    # The product recovered this itself, which is what the
                    # scenario was testing. Obligation DISCHARGED — not residue.
                    report["discharged"].append({**entry, "recovered_by": "product"})
                    self._mutation_close(**entry)
                    print(f"    discharged (product self-healed): {entry}")
                elif ok:
                    report["reversed"].append(entry)
                    self._mutation_close(**entry)
                    print(f"    restored: {entry}")
                else:
                    report["failed"].append(entry)
                    print(f"    RESTORE FAILED: {entry}")
            except Exception as exc:  # never let teardown crash the run silently
                report["failed"].append({**entry, "error": str(exc)[:200]})
                print(f"    RESTORE ERROR: {entry} — {exc}")

        self.restoration_report = report
        # Residue at teardown fails the scenario EVEN IF the harness reversed it
        # successfully. The auto-reversal exists to protect the NEXT scenario;
        # the failure exists to tell this scenario's author that it does not
        # clean up after itself. If a successful auto-restore counted as a pass,
        # the safety net would quietly become a crutch and every scenario could
        # keep leaking forever without anyone being told.
        # Residue = anything we had to reverse ourselves, could not reverse, or
        # that the product failed to self-heal. Obligations the product
        # discharged on its own are not residue and must not fail the scenario.
        ok = not (report["reversed"] or report["failed"] or report["unrestorable"])
        self.evidence.record("restoration", "enforce_restoration", "restoration",
                             {}, {"residue_free": True}, report, ok)
        return ok

    def _chaos_fail(self, section, item_id, action, params, reason) -> bool:
        result = {"action": action, "error": reason}
        self.evidence.record(section, item_id, action, params, {}, result, False)
        print(f"    ERROR: {item_id} — {reason}")
        return False

    # ── probe dispatch ────────────────────────────────────────────────────────

    def _call_probe(self, probe: str, params: dict) -> dict:
        """
        Call a probe function from probes.sh via bash.
        The probe name "cluster.health" maps to function probe_cluster_health.
        Params dict becomes --key value args.
        """
        func_name = "probe_" + probe.replace(".", "_")

        # Build --key value args from params dict
        args = []
        for k, v in params.items():
            args.extend([f"--{k}", str(v)])

        args_str = " ".join(shlex.quote(a) for a in args)
        cmd = f'source "{PROBES_SH}" && {func_name} {args_str}'

        if self.verbose:
            print(f"    [probe] bash -c '{func_name} {args_str}'")

        try:
            proc = subprocess.run(
                ["bash", "-c", cmd],
                capture_output=True, text=True, timeout=45
            )
            stdout = proc.stdout.strip()
            stderr = proc.stderr.strip()

            if not stdout:
                return {
                    "error": f"probe returned no output (exit {proc.returncode})",
                    "stderr": stderr[:200] if stderr else "",
                }

            try:
                return json.loads(stdout)
            except json.JSONDecodeError:
                # Probe returned non-JSON — treat as raw string
                return {"raw": stdout, "exit_code": proc.returncode}

        except subprocess.TimeoutExpired:
            return {"error": "probe timed out after 45s"}
        except Exception as e:
            return {"error": str(e)}

    # ── expectation checking ──────────────────────────────────────────────────

    def _check_expect(self, result: dict, expect: dict) -> tuple[bool, list]:
        """
        Check result against expect block.
        Supports:
          key: value           — exact equality
          key_gte: N           — numeric >= N (key is the field name without _gte)
          key_lte: N           — numeric <= N
          key_contains: str    — string contains substring
          present: true/false  — dict has/lacks a truthy value
        """
        if not isinstance(result, dict):
            return False, [f"expected dict result, got {type(result).__name__}: {result}"]

        failures = []
        for raw_key, expected_val in expect.items():
            # Determine operator from key suffix
            if raw_key.endswith("_gte"):
                field = raw_key[:-4]
                actual = result.get(field)
                try:
                    if float(actual) < float(expected_val):
                        failures.append(
                            f"field '{field}': expected >= {expected_val}, got {actual}")
                except (TypeError, ValueError):
                    failures.append(
                        f"field '{field}': cannot compare {actual!r} >= {expected_val}")

            elif raw_key.endswith("_lte"):
                field = raw_key[:-4]
                actual = result.get(field)
                try:
                    if float(actual) > float(expected_val):
                        failures.append(
                            f"field '{field}': expected <= {expected_val}, got {actual}")
                except (TypeError, ValueError):
                    failures.append(
                        f"field '{field}': cannot compare {actual!r} <= {expected_val}")

            elif raw_key.endswith("_contains"):
                field = raw_key[:-9]
                actual = result.get(field, "")
                if str(expected_val) not in str(actual):
                    failures.append(
                        f"field '{field}': expected to contain {expected_val!r}, got {actual!r}")

            else:
                # Exact equality
                actual = result.get(raw_key)
                if actual != expected_val:
                    failures.append(
                        f"field '{raw_key}': expected {expected_val!r}, got {actual!r}")

        return len(failures) == 0, failures

    # ── schema validation ─────────────────────────────────────────────────────

    def _validate_schema(self) -> bool:
        required = ["version", "name", "suite"]
        missing = [f for f in required if f not in self.scenario]
        if missing:
            print(f"  ERROR: scenario missing required fields: {missing}", file=sys.stderr)
            return False
        if self.scenario.get("version") != 1:
            print(
                f"  ERROR: unsupported schema version: {self.scenario.get('version')}",
                file=sys.stderr)
            return False
        # Validate optional awareness block if present.
        aw = self.scenario.get("awareness")
        if aw is not None:
            if not isinstance(aw, dict):
                print("  ERROR: 'awareness' must be a mapping", file=sys.stderr)
                return False
            valid_keys = {
                "enabled", "task", "phase", "include_runtime", "runtime_window",
                "create_incident_on_failure", "expected_invariants", "expected_forbidden_fixes",
                "create_proposal_on_failure", "expected_failure_modes", "training",
                "patterns",
            }
            unknown = set(aw.keys()) - valid_keys
            if unknown:
                print(f"  ERROR: unknown keys in awareness block: {sorted(unknown)}",
                      file=sys.stderr)
                return False
            # Validate patterns sub-block
            patterns_cfg = aw.get("patterns")
            if patterns_cfg is not None:
                if not isinstance(patterns_cfg, dict):
                    print("  ERROR: 'awareness.patterns' must be a mapping", file=sys.stderr)
                    return False
                valid_pattern_keys = {"validate", "expected_invariants",
                                      "expected_code_smells_absent", "expected_behavior"}
                unknown_p = set(patterns_cfg.keys()) - valid_pattern_keys
                if unknown_p:
                    print(f"  ERROR: unknown keys in awareness.patterns block: {sorted(unknown_p)}",
                          file=sys.stderr)
                    return False
                KNOWN_PATTERN_IDS = {
                    "pattern.control_plane_data_plane", "pattern.desired_state_reconciliation",
                    "pattern.leased_leadership_single_writer", "pattern.consensus_backed_authority",
                    "pattern.last_known_good", "pattern.circuit_breaker_distributed",
                    "pattern.bulkhead", "pattern.saga_durable_workflow",
                    "pattern.idempotent_executor", "pattern.durable_event_outbox",
                    "pattern.health_gate", "pattern.explicit_degraded_mode",
                    "pattern.fencing_token_generation_guard", "pattern.intent_marker_tombstone",
                    "pattern.read_repair_authority_repair", "pattern.backpressure",
                    "pattern.bootstrap_then_promote", "pattern.dns_independent_recovery",
                    "pattern.split_brain_prevention", "pattern.bounded_critical_query",
                    # legacy patterns.yaml entries
                    "pattern.persistence_gap", "pattern.error_swallowing",
                    "pattern.stale_authority", "pattern.partial_truth",
                    "pattern.unverified_runtime_truth", "pattern.unbounded_critical_query",
                    "pattern.destructive_absence", "pattern.missing_intent_marker",
                    "pattern.version_only_identity",
                    "pattern.runtime_observation_as_desired_authority",
                    "pattern.ephemeral_state_contamination", "pattern.unit_type_shadowing",
                }
                for pid in (patterns_cfg.get("validate") or []):
                    if not str(pid).startswith("pattern."):
                        print(f"  ERROR: pattern ID must start with 'pattern.': {pid}",
                              file=sys.stderr)
                        return False
                    if pid not in KNOWN_PATTERN_IDS:
                        print(f"  ERROR: unknown pattern ID: {pid}", file=sys.stderr)
                        return False
        return True

    # ── output ────────────────────────────────────────────────────────────────

    def _awareness_artifact_status(self) -> dict:
        """Return a status dict for each awareness artifact type."""
        adir = os.path.join(self.output_dir, "awareness")
        if not os.path.isdir(adir):
            return {}
        skipped = os.path.exists(os.path.join(adir, "SKIPPED.txt"))

        def _status(base_names, error_names=None):
            if skipped:
                return "SKIPPED"
            for n in (base_names if isinstance(base_names, list) else [base_names]):
                if os.path.exists(os.path.join(adir, n)):
                    return "PASS"
            for n in (error_names or []):
                if os.path.exists(os.path.join(adir, n)):
                    return "ERROR"
            return "SKIPPED"

        incident_status = "SKIPPED"
        if not skipped:
            if os.path.exists(os.path.join(adir, "incident.yaml")):
                incident_status = "CREATED"
            elif os.path.exists(os.path.join(adir, "incident.error.txt")):
                incident_status = "ERROR"

        proposal_status = "SKIPPED"
        if not skipped:
            if os.path.exists(os.path.join(adir, "proposal.yaml")):
                proposal_status = "DRAFT"
            elif os.path.exists(os.path.join(adir, "proposal.error.txt")):
                proposal_status = "ERROR"

        return {
            "preflight": _status(
                ["preflight.agent.txt", "preflight.json"]),
            "debug-session": _status(
                ["debug-session.agent.txt", "debug-session.json"]),
            "runtime-snapshot": _status(
                ["runtime-snapshot.json"],
                ["runtime-snapshot.error.txt"]),
            "incident": incident_status,
            "proposal": proposal_status,
        }

    def _write_patterns_md(self, pattern_result: str) -> None:
        """Write PATTERNS.md summarizing pattern validation evidence."""
        patterns_md_path = os.path.join(self.output_dir, "PATTERNS.md")
        adir = os.path.join(self.output_dir, "awareness")
        val_file = os.path.join(adir, "patterns", "validation.json")

        val = {}
        if os.path.exists(val_file):
            try:
                with open(val_file) as f:
                    val = json.load(f)
            except Exception:
                pass

        # Gather evidence presence
        preflight_present = os.path.exists(os.path.join(adir, "preflight.json"))
        debug_present = os.path.exists(os.path.join(adir, "debug-session.json"))

        # Extract matched data from preflight if available
        pf_invariants: list = []
        pf_fail_modes: list = []
        pf_forbidden: list = []
        pf_code_smells: list = []
        if preflight_present:
            try:
                with open(os.path.join(adir, "preflight.json")) as fh:
                    pf = json.load(fh)
                pf_invariants = pf.get("matched_invariants") or pf.get("invariants") or []
                pf_fail_modes = pf.get("matched_failure_modes") or pf.get("failure_modes") or []
                pf_forbidden = pf.get("forbidden_fixes") or []
                pf_code_smells = pf.get("code_smells") or []
            except Exception:
                pass

        patterns_tested = self.awareness.patterns_validate
        expected_invariants = self.awareness.expected_invariants_for_patterns
        expected_smells_absent = self.awareness.expected_code_smells_absent
        patterns_matched = val.get("patterns_with_output") or []
        patterns_missing = val.get("patterns_missing") or []

        missing_evidence = []
        if not preflight_present:
            missing_evidence.append("preflight.json")
        if not debug_present:
            missing_evidence.append("debug-session.json")
        if patterns_missing:
            missing_evidence.extend([f"pattern output for {p}" for p in patterns_missing])

        with open(patterns_md_path, "w") as f:
            f.write("# Pattern Validation\n\n")

            f.write("## Patterns tested\n\n")
            if patterns_tested:
                for p in patterns_tested:
                    f.write(f"- {p}\n")
            else:
                f.write("- (none)\n")
            f.write("\n")

            f.write("## Expected invariants\n\n")
            if expected_invariants:
                for inv in expected_invariants:
                    f.write(f"- {inv}\n")
            else:
                f.write("- (none specified)\n")
            f.write("\n")

            f.write("## Expected code smells absent\n\n")
            if expected_smells_absent:
                for s in expected_smells_absent:
                    f.write(f"- {s}\n")
            else:
                f.write("- (none specified)\n")
            f.write("\n")

            f.write("## Runtime evidence\n\n")
            f.write(f"- preflight.json: {'present' if preflight_present else 'absent'}\n")
            f.write(f"- debug-session.json: {'present' if debug_present else 'absent'}\n")
            f.write("\n")

            f.write("## Awareness matches\n\n")
            f.write(f"- patterns: {patterns_matched if patterns_matched else '(none matched)'}\n")
            if pf_invariants:
                f.write(f"- invariants: {pf_invariants[:5]}"
                        f"{'...' if len(pf_invariants) > 5 else ''}\n")
            else:
                f.write("- invariants: (none)\n")
            if pf_fail_modes:
                f.write(f"- failure modes: {pf_fail_modes[:5]}"
                        f"{'...' if len(pf_fail_modes) > 5 else ''}\n")
            else:
                f.write("- failure modes: (none)\n")
            if pf_forbidden:
                f.write(f"- forbidden fixes: {pf_forbidden[:5]}"
                        f"{'...' if len(pf_forbidden) > 5 else ''}\n")
            else:
                f.write("- forbidden fixes: (none)\n")
            if pf_code_smells:
                f.write(f"- code smells: {pf_code_smells[:5]}"
                        f"{'...' if len(pf_code_smells) > 5 else ''}\n")
            else:
                f.write("- code smells: (none)\n")
            f.write("\n")

            f.write(f"## Result\n\n{pattern_result}\n\n")

            f.write("## Notes\n\n")
            f.write("- lab-only topology: single-node quickstart"
                    " (not full 3-node production cluster)\n")
            if missing_evidence:
                for m in missing_evidence:
                    f.write(f"- missing evidence: {m}\n")
            rec = val.get("recommended_next_scenario") or ""
            if rec:
                f.write(f"- recommended next scenario: {rec}\n")

    def _write_output(self, passed: bool, result: str = "", awareness_result: str = ""):
        os.makedirs(self.output_dir, exist_ok=True)
        result = result or ("PASS" if passed else "FAIL")

        # evidence.json
        ev = self.evidence.to_dict()
        ev["passed"] = passed
        ev["result"] = result
        ev["awareness_result"] = awareness_result or "AWARENESS_SKIPPED"
        with open(os.path.join(self.output_dir, "evidence.json"), "w") as f:
            json.dump(ev, f, indent=2)

        # RESULT.md
        pass_count = sum(1 for i in ev["items"] if i.get("passed"))
        fail_count = len(ev["items"]) - pass_count
        awareness_status = self._awareness_artifact_status()

        # Parse matched invariants/failure modes from awareness JSON artifacts
        matched_inv: list = []
        matched_fm: list = []
        learning_rec = ""
        adir = os.path.join(self.output_dir, "awareness")
        for fname in ("preflight.json", "debug-session.json"):
            fpath = os.path.join(adir, fname)
            if os.path.exists(fpath):
                try:
                    with open(fpath) as fh:
                        d = json.load(fh)
                    for item in (d.get("matched_invariants") or d.get("invariants") or []):
                        n = item if isinstance(item, str) else (item.get("id") or str(item))
                        if n and n not in matched_inv:
                            matched_inv.append(n)
                    for item in (d.get("matched_failure_modes") or d.get("failure_modes") or []):
                        n = item if isinstance(item, str) else (item.get("id") or str(item))
                        if n and n not in matched_fm:
                            matched_fm.append(n)
                    if not learning_rec:
                        learning_rec = (d.get("learning_recommendation")
                                        or d.get("recommendation") or "")
                except Exception:
                    pass

        with open(os.path.join(self.output_dir, "RESULT.md"), "w") as f:
            f.write(f"# {ev['scenario']}\n\n")
            f.write(f"**Suite**: {ev['suite']}  \n")
            f.write(f"**Result**: {result}  \n")
            f.write(f"**Awareness**: {awareness_result or 'AWARENESS_SKIPPED'}  \n")
            f.write(f"**Time**: {ev['start_time']}  \n")
            f.write(f"**Checks**: {pass_count} passed, {fail_count} failed\n\n")

            if ev["items"]:
                f.write("## Checks\n\n")
                f.write("| Section | ID | Probe | Result |\n")
                f.write("|---------|----|----|--------|\n")
                for item in ev["items"]:
                    icon = "✓" if item.get("passed") else "✗"
                    f.write(
                        f"| {item['section']} | {item['id']} | {item['probe']} | {icon} |\n")

            if awareness_status:
                f.write("\n## Awareness\n\n")
                f.write("| Artifact | Status |\n")
                f.write("|----------|--------|\n")
                for key, status in awareness_status.items():
                    f.write(f"| {key} | {status} |\n")

                if matched_inv:
                    f.write(f"\n**Matched invariants**: {', '.join(matched_inv[:5])}")
                    if len(matched_inv) > 5:
                        f.write(f" (+{len(matched_inv)-5} more)")
                    f.write("\n")
                if matched_fm:
                    f.write(f"**Matched failure modes**: {', '.join(matched_fm[:5])}")
                    if len(matched_fm) > 5:
                        f.write(f" (+{len(matched_fm)-5} more)")
                    f.write("\n")
                if learning_rec:
                    f.write(f"**Recommendation**: {learning_rec[:120]}\n")

                adir_rel = "awareness"
                f.write(f"\nArtifacts: `{adir_rel}/`\n")
                for fname, label in [
                    ("preflight.agent.txt", "preflight.agent.txt"),
                    ("debug-session.agent.txt", "debug-session.agent.txt"),
                    ("runtime-snapshot.json", "runtime-snapshot.json"),
                    ("incident.yaml", "incident.yaml"),
                    ("proposal.yaml", "proposal.yaml [DRAFT — manual review required]"),
                ]:
                    if os.path.exists(os.path.join(self.output_dir, adir_rel, fname)):
                        f.write(f"- [{label}]({adir_rel}/{fname})\n")

                if os.path.exists(os.path.join(self.output_dir, adir_rel, "proposal.yaml")):
                    f.write("\n> **DRAFT PROPOSAL** — manual review required before approval.\n")
                    f.write("> Run: `globular awareness validate-proposal --file "
                            f"{adir_rel}/proposal.yaml`\n")

        # Write PATTERNS.md if patterns block is configured (always, even if SKIPPED)
        if self.awareness.patterns_validate is not None:
            pattern_result = getattr(self.awareness, "_pattern_result", "SKIPPED")
            self._write_patterns_md(pattern_result)
            patterns_md = os.path.join(self.output_dir, "PATTERNS.md")
            if os.path.exists(patterns_md):
                with open(os.path.join(self.output_dir, "RESULT.md"), "a") as rf:
                    rf.write(f"\n## Pattern Validation\n\n")
                    rf.write(f"**Pattern result**: {pattern_result}  \n")
                    rf.write(f"See [PATTERNS.md](PATTERNS.md) for full pattern evidence.\n")

        if self.baseline_captures:
            with open(os.path.join(self.output_dir, "RESULT.md"), "a") as f:
                f.write("\n## Baseline Captures\n\n```json\n")
                f.write(json.dumps(self.baseline_captures, indent=2))
                f.write("\n```\n")

    def _append_to_ledger(self, result: str, awareness_result: str) -> None:
        if not os.path.exists(TRAINING_SH):
            return
        scenario_name = self.scenario.get("name", "unknown")
        task = self.awareness.task or ""
        phase = self.awareness.phase or ""
        run_id = os.path.basename(self.output_dir)
        adir = os.path.join(self.output_dir, "awareness")
        incident_created = "true" if os.path.exists(
            os.path.join(adir, "incident.yaml")) else "false"
        proposal_created = "true" if os.path.exists(
            os.path.join(adir, "proposal.yaml")) else "false"
        awareness_status = awareness_result.replace("AWARENESS_", "")
        cmd = (
            f'source "{TRAINING_SH}" && '
            f'training_ledger_append '
            f'{shlex.quote(LEDGER_FILE)} '
            f'{shlex.quote(run_id)} '
            f'{shlex.quote(scenario_name)} '
            f'{shlex.quote(result)} '
            f'{shlex.quote(awareness_status)} '
            f'{shlex.quote(task)} '
            f'{shlex.quote(phase)} '
            f'{shlex.quote(incident_created)} '
            f'{shlex.quote(proposal_created)} '
            f'{shlex.quote(self.output_dir)}'
        )
        try:
            subprocess.run(["bash", "-c", cmd], timeout=30)
        except Exception as e:
            print(f"  [training] WARNING: ledger append error: {e}")

        # Pattern ledger — written separately if patterns were tested
        if self.awareness.patterns_validate:
            self._append_to_pattern_ledger(result)

    def _append_to_pattern_ledger(self, scenario_result: str) -> None:
        """Append one JSON line to the pattern-specific ledger."""
        pattern_ledger = os.path.join(
            os.path.dirname(LEDGER_FILE), "awareness-pattern-ledger.jsonl")
        adir = os.path.join(self.output_dir, "awareness")
        val_file = os.path.join(adir, "patterns", "validation.json")

        val = {}
        if os.path.exists(val_file):
            try:
                with open(val_file) as f:
                    val = json.load(f)
            except Exception:
                pass

        # Extract data from preflight.json for enrichment
        pf_code_smells: list = []
        pf_forbidden: list = []
        pf_invariants: list = []
        pf_path = os.path.join(adir, "preflight.json")
        if os.path.exists(pf_path):
            try:
                with open(pf_path) as fh:
                    pf = json.load(fh)
                pf_code_smells = pf.get("code_smells") or []
                pf_forbidden = pf.get("forbidden_fixes") or []
                pf_invariants = pf.get("matched_invariants") or pf.get("invariants") or []
            except Exception:
                pass

        patterns_tested = self.awareness.patterns_validate
        patterns_matched = val.get("patterns_with_output") or []
        pattern_result = getattr(self.awareness, "_pattern_result", "SKIPPED")
        scenario_name = self.scenario.get("name", "unknown")
        run_id = os.path.basename(self.output_dir)
        ts = datetime.datetime.utcnow().isoformat() + "Z"

        entry = {
            "run_id": run_id,
            "scenario": scenario_name,
            "timestamp": ts,
            "patterns_tested": patterns_tested,
            "patterns_matched": patterns_matched,
            "pattern_result": pattern_result,
            "code_smells": pf_code_smells[:10],
            "forbidden_fixes": pf_forbidden[:10],
            "new_failure_class": False,
            "matched_invariants": pf_invariants[:10],
            "scenario_result": scenario_result,
        }
        try:
            os.makedirs(os.path.dirname(pattern_ledger), exist_ok=True)
            with open(pattern_ledger, "a") as f:
                f.write(json.dumps(entry) + "\n")
            print(f"  [training] pattern-ledger: {pattern_ledger}")
        except Exception as e:
            print(f"  [training] WARNING: pattern ledger append error: {e}")


# ── main ──────────────────────────────────────────────────────────────────────

def main():
    args = sys.argv[1:]
    verbose = "--verbose" in args or "-v" in args
    args = [a for a in args if a not in ("--verbose", "-v")]

    if len(args) < 2:
        print(f"Usage: globular-scenario <scenario.yaml> <output-dir> [--verbose]",
              file=sys.stderr)
        sys.exit(1)

    scenario_file = args[0]
    output_dir = args[1]

    if not os.path.exists(scenario_file):
        print(f"ERROR: scenario not found: {scenario_file}", file=sys.stderr)
        sys.exit(1)

    os.makedirs(output_dir, exist_ok=True)

    executor = ScenarioExecutor(scenario_file, output_dir, verbose)
    passed = executor.run()
    sys.exit(0 if passed else 1)


if __name__ == "__main__":
    main()
