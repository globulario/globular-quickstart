1786387379 container exec_create: bash -c 
set -e
T=$(mktemp -d); cd $T
openssl req -x509 -newkey rsa:2048 -keyout ca.key -out ca.crt -nodes -subj "/CN=chaos-ca" -days 3650 2>/dev/null
openssl req -newkey rsa:2048 -keyout svc.key -out svc.csr -nodes -subj "/CN=chaos-expired" 2>/dev/null
mkdir -p demoCA/newcerts; touch demoCA/index.txt; echo 01 > demoCA/serial
cat > ca.cnf <<EOF
[ca]
default_ca = CA_default
[CA_default]
dir = $T/demoCA
database = \$dir/index.txt
serial = \$dir/serial
new_certs_dir = \$dir/newcerts
default_md = sha256
policy = pol
email_in_dn = no
rand_serial = no
unique_subject = no
[pol]
commonName = supplied
EOF
openssl ca -batch -config ca.cnf -cert ca.crt -keyfile ca.key -in svc.csr -out svc.crt \
  -startdate 20250101000000Z -enddate 20250102000000Z -notext 2>&1 | tail -2
echo "--- resulting dates ---"
openssl x509 -in svc.crt -noout -subject -dates
